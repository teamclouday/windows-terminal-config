{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{if .Root}}(Admin) {{end}}{{.Folder}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": " 😉 {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} ",
          "foreground": "#c386f1",
          "background": "#282c34",
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "template": " \uf0e7 ",
          "foreground": "#242424",
          "background": "#f1184c",
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#3A86FF",
          "background": "#282c34",
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": "/"
          },
          "template": "\ue5ff {{ .Path }} ",
          "foreground": "#33DD2D",
          "background": "#242424",
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "cache": {
            "duration": "5s",
            "strategy": "folder"
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \uf01c {{ .StashCount }}{{ end }} ",
          "foreground": "#6CA0FF",
          "background": "#242424",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#3a3320{{ end }}",
            "{{ if gt .Behind 0 }}#3a2024{{ end }}"
          ],
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "properties": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "home_enabled": false
          },
          "cache": {
            "duration": "30s",
            "strategy": "folder"
          },
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "#fffc44",
          "background": "#242424",
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "properties": {
            "home_enabled": false
          },
          "cache": {
            "duration": "30s",
            "strategy": "folder"
          },
          "template": " \ue70c {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#0184bc",
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "properties": {
            "style": "austin",
            "threshold": 500
          },
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#ffffff",
          "background": "#8800dd",
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b0"
        },
        {
          "template": " \uf00d {{ .Code }} ",
          "foreground": "#ffffff",
          "background": "#f1184c",
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b4"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "properties": {
            "time_format": "15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#FFBB00",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "template": "➜ ",
          "foreground": "#f1184c",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3
}
